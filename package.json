{
  "name": "lanyard-ssh",
  "productName": "Lanyard",
  "version": "1.1.0-beta.1",
  "description": "Wear the right identity everywhere: switch between GitHub, GitLab, Bitbucket and Hugging Face accounts in one click, and manage your remote SSH servers, keys, ssh-agent and known_hosts from a desktop app, the system tray or the command line.",
  "keywords": [
    "ssh",
    "ssh-config",
    "git",
    "github",
    "gitlab",
    "huggingface",
    "multiple-accounts",
    "ssh-keys",
    "cli",
    "ssh-manager",
    "remote-servers",
    "ssh-client",
    "tauri"
  ],
  "author": "riomar",
  "license": "MIT",
  "bin": {
    "lanyard": "bin/lanyard.js",
    "lny": "bin/lanyard.js",
    "lanyard-ssh": "bin/lanyard.js"
  },
  "files": [
    "bin/",
    "out/main/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "lanyard": "node bin/lanyard.js",
    "prepack": "npm run build:cli",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:sidecar": "esbuild src/sidecar/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=out/sidecar/index.js",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=out/main/cli.js --external:electron",
    "fetch:node": "node scripts/fetch-node.mjs",
    "build": "npm run build:renderer && npm run build:sidecar && npm run build:cli",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build && npm run fetch:node && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/lato": "^5.3.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.34.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "homepage": "https://github.com/riomar0001/lanyard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riomar0001/lanyard.git"
  },
  "bugs": {
    "url": "https://github.com/riomar0001/lanyard/issues"
  }
}
